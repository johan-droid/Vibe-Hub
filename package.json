{
  "name": "vibe-hub",
  "version": "3.0.0",
  "private": true,
  "description": "Autonomous IDE powered by a multi-agent AI swarm",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/user-interface",
    "apps/server-bridge"
  ],
  "dependencies": {
    "patch-package": "^8.0.1"
  },
  "scripts": {
    "postinstall": "node scripts/run-patch-package.mjs",
    "dev:ui": "npm run dev --workspace=apps/user-interface",
    "dev:server": "npm run dev --workspace=apps/server-bridge",
    "dev": "npx concurrently -n UI,BRAIN -c cyan,magenta \"npm run dev:ui\" \"npm run dev:server\"",
    "build:ui": "npm run build --workspace=apps/user-interface",
    "start:server": "npm run start --workspace=apps/server-bridge",
    "eval:parity": "node scripts/run-parity-eval.mjs",
    "validate": "node --check apps/server-bridge/index.js && node --check apps/server-bridge/orchestrator/index.js && node --check apps/server-bridge/orchestrator/skill-loader.js",
    "sanitize": "node scripts/selina-sanitize.mjs",
    "security:audit": "node scripts/selina-security-audit.mjs",
    "test:security": "npm test --workspace=apps/server-bridge -- --run test/security-audit.test.js test/security-regression.test.js",
    "release:gate": "node scripts/selina-release-gate.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "docker:build:server": "docker build -f apps/server-bridge/Dockerfile -t vibe-hub/server-bridge:local .",
    "docker:build:ui": "docker build -f apps/user-interface/Dockerfile -t vibe-hub/user-interface:local .",
    "docker:build": "npm run docker:build:server && npm run docker:build:ui"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^7.3.3"
  },
  "overrides": {
    "workbox-build": {
      "@rollup/plugin-terser": "^1.0.0"
    },
    "dompurify": "^3.4.2",
    "express-rate-limit": "^8.5.1",
    "ip-address": "^10.2.0",
    "serialize-javascript": "^7.0.5",
    "hono": "4.12.18"
  }
}

# Selina user-interface env template
# Copy this to apps/user-interface/.env.local for local development.

VITE_API_BASE=http://localhost:3001
VITE_WS_BASE=ws://localhost:3001
VITE_API_URL=http://localhost:3001
VITE_AGENT_MODEL_LABEL=OpenAI Responses
VITE_TEST_MODE=false
VITE_SELINA_MAX_SURGICAL_DELTA_CHARS=20000

# Optional: Playwright e2e overrides
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
PLAYWRIGHT_SKIP_WEB_SERVER=false

# IMPORTANT: Secrets have been redacted from this file. Do NOT commit real secrets.
# Populate these values from your secret manager (Render/Heroku/Env/CI) for production.
DATABASE_URL="postgresql://user:password@db-host:5432/vibe_hub_prod"
ENABLE_TERMINAL_CAPPING=true
GEMINI_API_KEY=
GITHUB_APP_ID=3578960
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
JWT_SECRET=
LOG_LEVEL=info
MAX_TERMINAL_LOG_SIZE=50000
NODE_ENV=production
OPENAI_API_KEY=
PORT=3001
UI_ORIGIN=http://localhost:5173

# === Selina production MVP runtime additions ===
CSRF_SECRET=
CSRF_SAME_SITE=strict
UI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
SESSION_EXPIRY_DAYS=7
REFRESH_TOKEN_EXPIRY_DAYS=30
VIBE_MASTER_KEY=

# Model gateway: use OpenAI first to avoid Gemini free-tier quota stalls.
GEMINI_MODEL=gemini-2.0-flash
SELINA_MODEL_PROVIDER=openai
SELINA_AGENT_PROVIDER=openai
OPENAI_API_MODE=responses
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
SELINA_MODEL_TIMEOUT_MS=45000
SELINA_MODEL_RETRIES=2
SELINA_MODEL_FALLBACKS=gemini,qwen,anthropic
SELINA_HISTORY_TOKEN_BUDGET=24000
SELINA_MAX_OUTPUT_TOKENS=2048
SELINA_FORCED_LOGIN_METHOD=
SELINA_TOOL_APPROVAL_TIMEOUT_MS=120000
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
GITHUB_TOKEN=
LLM_MODEL=
LLM_API_ENDPOINT=
LLM_PROVIDER_TIMEOUT_MS=45000
LLM_CIRCUIT_RESET_MS=60000
LLM_COST_PER_1K_TOKENS=0
LLM_CACHE_TTL_SECONDS=1800

# Database, cache, and VFS.
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA=
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
REDIS_URL=
REDIS_TLS=false
REDIS_KEY_PREFIX=selina
REDIS_MAX_RETRIES=3
VFS_TTL_SECONDS=86400
AST_CACHE_TTL_SECONDS=3600
CONTEXT_CACHE_TTL_SECONDS=300

# Orchestrator, sandbox, and local-Docker-only execution.
USE_V6_CONTEXT=true
USE_XSTATE_MACHINE=true
CODE_QUEUE_NAME=selina-code
ORCHESTRATION_WORKER_CONCURRENCY=2
ORCHESTRATION_JOB_ATTEMPTS=2
ORCHESTRATION_JOB_BACKOFF_MS=2000
ORCHESTRATION_JOB_LOCK_MS=300000
SELINA_ROLLOUT_DIR=./scratch/rollouts
SELINA_SANDBOX_TIMEOUT_MS=10000
MAX_CONSECUTIVE_ROLLBACKS=3
MAX_CONCURRENT_SESSIONS=50

# Rate limits, observability, and transport limits.
RATE_LIMIT_GENERAL=100
RATE_LIMIT_API=30
RATE_LIMIT_ORCHESTRATION=5
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_TO_FILE=false
AUDIT_LOGS_DISABLED=false
HEALTH_CHECK_TIMEOUT_MS=2500
WS_RATE_WINDOW_MS=60000
WS_MAX_CONNECTIONS_PER_WINDOW=30
WS_MAX_ACTIVE_PER_IP=50
WS_MAX_ACTIVE_PER_USER=5
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_COMPRESSION_THRESHOLD=1024
TRUST_PROXY_HOPS=1
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
IDEMPOTENCY_TTL_SECONDS=3600

# Optional creative UI variant service.
UI_VARIANT_API_KEY=
UI_VARIANT_API_URL=

# === LLM & Brain ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SELINA_MODEL_PROVIDER=nim
SELINA_AGENT_PROVIDER=nim
OPENAI_API_MODE=responses     # responses | chat
SELINA_MODEL_TIMEOUT_MS=45000
SELINA_MODEL_RETRIES=2
SELINA_MODEL_MAX_RETRY_AFTER_MS=8000
SELINA_MODEL_FALLBACKS=openai,anthropic,qwen,gemini
SELINA_EXPERT_CODE_PROVIDER=nim
SELINA_EXPERT_DEBUG_PROVIDER=nim
SELINA_EXPERT_MANAGER_PROVIDER=nim
SELINA_ACTION_GRANT_TTL_MS=120000
SELINA_ENABLE_JSONRPC_EVENTS=true
SELINA_HISTORY_TOKEN_BUDGET=24000
SELINA_MAX_OUTPUT_TOKENS=2048
# Optional: api-key | oauth | blank
SELINA_FORCED_LOGIN_METHOD=
SELINA_TOOL_APPROVAL_TIMEOUT_MS=120000
SELINA_MAX_SURGICAL_DELTA_CHARS=20000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=              # Optional: Codex/GPT coding model exposed by your provider account
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-4-maverick-17b-128e-instruct
NIM_TEMPERATURE=1.0
NIM_TOP_P=1.0
NIM_FREQUENCY_PENALTY=0.0
NIM_PRESENCE_PENALTY=0.0
QWEN_API_KEY=
QWEN_BASE_URL=             # OpenAI-compatible Qwen endpoint
QWEN_MODEL=                # Qwen coder model name
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=           # Claude coding model name
ANTHROPIC_VERSION=2023-06-01
GITHUB_TOKEN=          # For GitHub Models heavy-lifting (Phase 3)
LLM_MODEL=
LLM_API_ENDPOINT=
LLM_PROVIDER_TIMEOUT_MS=45000
LLM_CIRCUIT_RESET_MS=60000

# === Server & Security ===
PORT=3001
NODE_ENV=development
JWT_SECRET=change_me_to_a_random_string
CSRF_SECRET=change_me_to_a_different_random_string
CSRF_SAME_SITE=lax
UI_ORIGIN=http://localhost:5173
UI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
SESSION_EXPIRY_DAYS=7
REFRESH_TOKEN_EXPIRY_DAYS=30
VIBE_MASTER_KEY=change_me_to_32_random_bytes_hex

# === Database ===
DATABASE_URL=postgresql://<db_user>:<db_password>@<project>.supabase.co:5432/<db_name>?sslmode=require
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
REDIS_URL=redis://localhost:6379/0
REDIS_TLS=false
REDIS_KEY_PREFIX=selina
REDIS_MAX_RETRIES=3
VFS_TTL_SECONDS=86400

# === GitHub App (Phase 3/4) ===
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=    # Multi-line PEM string
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# === OAuth: Google ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# === OAuth: GitHub ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# === Creative Swarm (Phase 5) ===
UI_VARIANT_API_KEY=    # Optional: override for UIVariantService
UI_VARIANT_API_URL=    # Optional: custom endpoint

# === Observability & Operations ===
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
LOG_TO_FILE=false
AUDIT_LOGS_DISABLED=false
HEALTH_CHECK_TIMEOUT_MS=2500
RATE_LIMIT_GENERAL=1000
RATE_LIMIT_API=300
RATE_LIMIT_ORCHESTRATION=60
MAX_CONCURRENT_SESSIONS=50
MAX_CONSECUTIVE_ROLLBACKS=3
WS_RATE_WINDOW_MS=60000
WS_MAX_CONNECTIONS_PER_WINDOW=300
WS_MAX_ACTIVE_PER_IP=500
WS_MAX_ACTIVE_PER_USER=50
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_COMPRESSION_THRESHOLD=1024
TRUST_PROXY_HOPS=0
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
IDEMPOTENCY_TTL_SECONDS=3600

# === Agent Orchestrator ===
USE_V6_CONTEXT=true
USE_XSTATE_MACHINE=true
CODE_QUEUE_NAME=selina-code
ORCHESTRATION_WORKER_CONCURRENCY=2
ORCHESTRATION_JOB_ATTEMPTS=2
ORCHESTRATION_JOB_BACKOFF_MS=2000
ORCHESTRATION_JOB_LOCK_MS=300000
SELINA_ROLLOUT_DIR=./scratch/rollouts
SELINA_SANDBOX_TIMEOUT_MS=10000
LLM_COST_PER_1K_TOKENS=0
LLM_CACHE_TTL_SECONDS=1800
AST_CACHE_TTL_SECONDS=3600
CONTEXT_CACHE_TTL_SECONDS=300

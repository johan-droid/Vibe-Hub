# ==============================================================================
# Selina (Vibe Hub) - Environment Configuration Template
# ==============================================================================
# Copy this file to `apps/server-bridge/.env` and update the values.
# IMPORTANT: Never commit actual API keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Configuration
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
LOG_TO_FILE=false
AUDIT_LOGS_DISABLED=false

# ------------------------------------------------------------------------------
# 2. Database & Cache
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/selina
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA=
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=selina
REDIS_MAX_RETRIES=3

# Postgres Connection Pool Options
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# JWT & CSRF
JWT_SECRET=super_secret_jwt_key_change_me_in_production
CSRF_SECRET=super_secret_csrf_key_change_me_in_production
CSRF_SAME_SITE=lax
VIBE_MASTER_KEY=master_key_for_testing

# OAuth: Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# OAuth: GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# Session Rules
SESSION_EXPIRY_DAYS=7
REFRESH_TOKEN_EXPIRY_DAYS=30
MAX_CONCURRENT_SESSIONS=50
SELINA_FORCED_LOGIN_METHOD=

# Origins & CORS
UI_ORIGIN=http://localhost:5173
UI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# 4. AI & Model Providers (The MOE Engine)
# ------------------------------------------------------------------------------
# Default MOE Engine Selection
SELINA_MODEL_PROVIDER=nim
SELINA_AGENT_PROVIDER=nim

# Fallback & Tuning Rules
SELINA_MODEL_FALLBACKS=openai,anthropic,qwen,gemini
SELINA_MODEL_TIMEOUT_MS=45000
SELINA_MODEL_RETRIES=2
SELINA_MODEL_MAX_RETRY_AFTER_MS=8000

# Agent Roles Default Engine
SELINA_EXPERT_CODE_PROVIDER=nim
SELINA_EXPERT_DEBUG_PROVIDER=nim
SELINA_EXPERT_MANAGER_PROVIDER=nim

# Gemini Config
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI Config
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_API_MODE=responses

# Anthropic Config
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_VERSION=2023-06-01

# NIM Config
NIM_API_KEY=your_nvidia_nim_api_key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-4-maverick-17b-128e-instruct
NIM_TEMPERATURE=1.0
NIM_TOP_P=1.0
NIM_FREQUENCY_PENALTY=0.0
NIM_PRESENCE_PENALTY=0.0

# Qwen Config
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=
QWEN_MODEL=qwen-max

# Multi-Key Rotation Sets (Optional: Comma-separated lists for load balancing)
GROQ_KEYS="gsk_1,gsk_2,gsk_3"
NVIDIA_NIM_KEYS="nvapi_1,nvapi_2,nvapi_3"
GEMINI_KEYS="AIzaSy_1,AIzaSy_2"

# Legacy Model Config (For backwards compatibility)
LLM_MODEL=
LLM_API_ENDPOINT=
LLM_PROVIDER_TIMEOUT_MS=45000
LLM_CIRCUIT_RESET_MS=60000

# ------------------------------------------------------------------------------
# 5. Agent Workflow & Orchestration Knobs
# ------------------------------------------------------------------------------
# Token Budgets & Constraints
SELINA_HISTORY_TOKEN_BUDGET=24000
SELINA_MAX_OUTPUT_TOKENS=2048
SELINA_MAX_SURGICAL_DELTA_CHARS=20000

# Memory & VFS
VFS_TTL_SECONDS=86400
LLM_CACHE_TTL_SECONDS=1800
AST_CACHE_TTL_SECONDS=3600
CONTEXT_CACHE_TTL_SECONDS=300
USE_V6_CONTEXT=true
USE_XSTATE_MACHINE=true

# Task Execution
CODE_QUEUE_NAME=selina-code
ORCHESTRATION_WORKER_CONCURRENCY=2
ORCHESTRATION_JOB_ATTEMPTS=2
ORCHESTRATION_JOB_BACKOFF_MS=2000
ORCHESTRATION_JOB_LOCK_MS=300000
SELINA_ACTION_GRANT_TTL_MS=120000
SELINA_TOOL_APPROVAL_TIMEOUT_MS=120000
SELINA_SANDBOX_TIMEOUT_MS=10000

# Features
SELINA_ENABLE_JSONRPC_EVENTS=true
SELINA_ROLLOUT_DIR=./scratch/rollouts
MAX_CONSECUTIVE_ROLLBACKS=3
LLM_COST_PER_1K_TOKENS=0
IDEMPOTENCY_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 6. WebSockets & Network
# ------------------------------------------------------------------------------
WS_RATE_WINDOW_MS=60000
WS_MAX_CONNECTIONS_PER_WINDOW=300
WS_MAX_ACTIVE_PER_IP=500
WS_MAX_ACTIVE_PER_USER=50
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_COMPRESSION_THRESHOLD=1024

RATE_LIMIT_GENERAL=1000
RATE_LIMIT_API=300
RATE_LIMIT_ORCHESTRATION=60

HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
TRUST_PROXY_HOPS=0
HEALTH_CHECK_TIMEOUT_MS=2500

# ------------------------------------------------------------------------------
# 7. External Integrations (Optional)
# ------------------------------------------------------------------------------
# GitHub Integration & Actions
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY=your_github_private_key
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Sentry Monitoring
SENTRY_DSN=your_sentry_dsn
SENTRY_TRACES_SAMPLE_RATE=0.1

# UI Variant Feature Toggles
UI_VARIANT_API_KEY=
UI_VARIANT_API_URL=

# ==============================================================================
# VIBE HUB FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file serves as a template and documentation for all frontend environment
# variables. Copy this to `frontend/.env.local` for local development.
# Vite requires environment variables to be prefixed with `VITE_` to be 
# exposed to the client-side code.
# ==============================================================================

# === 1. API & WebSocket Connections ===
# VITE_API_BASE: The base HTTP URL of the backend API.
# Used for standard REST requests (e.g. fetching config, user data).
VITE_API_BASE=http://localhost:3001

# VITE_WS_BASE: The base WebSocket URL for real-time agent communication.
# Essential for live streaming LLM responses and agent status updates.
VITE_WS_BASE=ws://localhost:3001

# VITE_API_URL: Redundant fallback for API base, ensuring compatibility 
# across different environment setups.
VITE_API_URL=http://localhost:3001

# === 2. Application Configuration ===
# VITE_AGENT_MODEL_LABEL: A UI display string representing the current LLM
# being used (e.g., "OpenAI Responses"). This is visual only.
VITE_AGENT_MODEL_LABEL=OpenAI Responses

# VITE_TEST_MODE: A boolean flag to enable or disable test-specific features 
# in the UI. Often used to mock certain interactions during manual QA.
VITE_TEST_MODE=false

# VITE_SELINA_MAX_SURGICAL_DELTA_CHARS: Determines the maximum size of a text 
# replacement delta the frontend is allowed to process in one go. Protects
# against massively bloated UI updates that could hang the browser.
VITE_SELINA_MAX_SURGICAL_DELTA_CHARS=20000

# === 3. End-to-End Testing (Playwright) ===
# These overrides are primarily used in CI/CD or local test environments.

# PLAYWRIGHT_BASE_URL: Overrides the default base URL for Playwright tests,
# ensuring the testing framework knows exactly where the app is hosted.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173

# PLAYWRIGHT_SKIP_WEB_SERVER: If set to true, Playwright will assume the web 
# server is already running (e.g., via `npm run dev`) and won't try to start 
# it during the test suite.
PLAYWRIGHT_SKIP_WEB_SERVER=false

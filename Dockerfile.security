# ═══════════════════════════════════════════════════════════════════════════════
# Vibe-Hub Code Execution Sandbox
# Image: vibe-hub-sandbox:latest
#
# SECURITY DESIGN RATIONALE
# ──────────────────────────
# The previous image (ubuntu:22.04 + semgrep + sqlmap + ZAP) was intended for
# security *scanning*, not code *execution*. Shipping attack-tooling inside the
# same image the LLM executes code in is a category error: it gives a
# prompt-injected payload an entire exploit kit at zero cost.
#
# This image is purpose-built for ONE job: run untrusted Node.js / shell
# scripts in strict isolation. It is:
#   • Minimal  — node:22-alpine3.19 base (~120 MB vs ~1.4 GB for ubuntu + tools)
#   • Non-root — "sandbox" user, UID 10001, no sudo, no login shell
#   • No pkg mgr at runtime — apk/npm global installs removed after build
#   • Read-only root filesystem (enforced by Docker run flags in the controller)
#   • No network (enforced by --network none in the controller)
#   • No new privileges (--security-opt no-new-privileges)
#
# WSL2 / Docker Desktop note:
#   Alpine images start in <150 ms under WSL2 because they skip systemd and
#   udev. This preserves the "vibe" workflow on the Ryzen 5 5500U host.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: dependency installer ─────────────────────────────────────────────
# Separate build stage so dev tools (npm, git) never appear in the final layer.
FROM node:22-alpine3.19 AS deps

WORKDIR /build

# Only copy manifests first → Docker cache layer for deps is stable across
# code changes. The agent's generated scripts go in at runtime via bind mount.
COPY package*.json ./

# Install production deps only; clean apk cache immediately.
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

# ── Stage 2: hardened runtime ──────────────────────────────────────────────────
FROM node:22-alpine3.19 AS runtime

# ── 2a. Create a locked-down non-root user ────────────────────────────────────
#   UID/GID 10001: a high UID outside standard system ranges minimises the
#   risk of UID collision if the container escapes into the host's user
#   namespace (relevant on older WSL2 kernel versions without user-ns remapping).
RUN addgroup -g 10001 -S sandbox \
 && adduser  -u 10001 -S -G sandbox -s /sbin/nologin -h /home/sandbox sandbox

# ── 2b. Remove shell attack surface ───────────────────────────────────────────
#   We remove bash (not present on Alpine anyway) and ensure sh is only used
#   internally by Node child_process, never interactively.
#   apk is kept at build time but its cache is wiped so payloads cannot
#   invoke `apk add` to install wget/curl/nc etc. at runtime.
RUN apk update \
 && apk add --no-cache \
      # tini: PID-1 zombie reaper — critical when the LLM spawns child procs
      # that die before their parent. Without tini, zombie PIDs accumulate.
      tini \
 && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# ── 2c. Copy only the node_modules built in Stage 1 ──────────────────────────
COPY --from=deps --chown=sandbox:sandbox /build/node_modules /app/node_modules

# ── 2d. Workspace directory ───────────────────────────────────────────────────
#   /workspace is the bind-mount target (read-only).
#   /tmp and /sandbox-output are the only writable areas (tmpfs at runtime).
RUN mkdir -p /workspace /sandbox-output \
 && chown sandbox:sandbox /workspace /sandbox-output

WORKDIR /workspace

# ── 2e. Drop to non-root ──────────────────────────────────────────────────────
USER sandbox

# ── 2f. Environment hardening ─────────────────────────────────────────────────
#   NODE_ENV=production disables devDependency loading.
#   NODE_OPTIONS prevents --inspect (debugger attachment from within).
#   HOME must point somewhere the user owns; sandbox's home is /home/sandbox.
ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=192 --disallow-code-generation-from-strings" \
    HOME=/home/sandbox \
    PATH=/usr/local/bin:/usr/bin:/bin

# ── 2g. Entrypoint ────────────────────────────────────────────────────────────
#   tini as PID-1:
#     - Properly forwards SIGTERM from `docker stop` → child process
#     - Reaps zombie processes left by misbehaving scripts
#   We do NOT set a default CMD; the controller passes the script path at
#   runtime via `docker run … node /workspace/<script>`.
ENTRYPOINT ["/sbin/tini", "--"]

# ── 2h. Healthcheck placeholder ───────────────────────────────────────────────
#   Not used operationally (network=none), but satisfies docker inspect probes
#   from the controller during the readiness check.
HEALTHCHECK --interval=5s --timeout=2s --retries=1 CMD ["true"]

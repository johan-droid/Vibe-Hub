{
  "title": "Selina Server Bridge Observability",
  "tags": ["selina", "server-bridge", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Rate by Route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (method, route, status)",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 Duration",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Orchestration Queue Depth",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "orchestration_queue_depth{metric=\"waiting\"}",
          "legendFormat": "{{lane}} waiting"
        },
        {
          "expr": "orchestration_queue_depth{metric=\"active\"}",
          "legendFormat": "{{lane}} active"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG Recall p95",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_recall_duration_seconds_bucket[5m])) by (le, source, cache))",
          "legendFormat": "{{source}} {{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Token Throughput",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_token_throughput_tokens_per_second_bucket[5m])) by (le, provider, model))",
          "legendFormat": "{{provider}} {{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Orchestration Step SLO Burn",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(orchestration_step_slo_events_total{result=\"violated\",slo=\"step_lt_2s\"}[5m])) / sum(rate(orchestration_step_slo_events_total{slo=\"step_lt_2s\"}[5m]))",
          "legendFormat": "5m violation ratio"
        },
        {
          "expr": "sum(rate(orchestration_step_slo_events_total{result=\"violated\",slo=\"step_lt_2s\"}[1h])) / sum(rate(orchestration_step_slo_events_total{slo=\"step_lt_2s\"}[1h]))",
          "legendFormat": "1h violation ratio"
        }
      ]
    }
  ]
}

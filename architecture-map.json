{
  "architecture": {
    "type": "5-Layer Security and Execution Architecture",
    "layers": [
      {
        "name": "Layer 1: Network Layer",
        "components": ["HTTPS", "CORS", "Helmet.js"],
        "directory": "apps/server-bridge/"
      },
      {
        "name": "Layer 2: Application Layer",
        "components": ["JWT validation", "rate limiting", "Express"],
        "directory": "apps/server-bridge/"
      },
      {
        "name": "Layer 3: Data Layer",
        "components": ["SQL injection prevention", "input validation", "PostgreSQL", "pgvector", "Redis"],
        "directory": "apps/server-bridge/"
      },
      {
        "name": "Layer 4: Execution Layer",
        "components": ["Docker isolation", "no network access", "SandboxExecutor"],
        "directory": "apps/server-bridge/sandbox/"
      },
      {
        "name": "Layer 5: Audit Layer",
        "components": ["Structured logging", "request tracing"],
        "directory": "apps/server-bridge/"
      }
    ]
  },
  "agents": {
    "engines": ["groq", "nim", "gemini"],
    "primary": [
      {
        "name": "Code Expert",
        "inputs": ["read_file", "context"],
        "outputs": ["edit_file", "build_check"]
      },
      {
        "name": "UI Expert",
        "inputs": ["component source", "tailwind config"],
        "outputs": ["JSX Code", "Tailwind styling"]
      },
      {
        "name": "Debugger Expert",
        "inputs": ["Error messages", "Stack traces", "Build output", "Source code"],
        "outputs": ["Surgical Fixes"]
      },
      {
        "name": "Git Expert",
        "inputs": ["Git Status"],
        "outputs": ["Commits", "PRs", "Comments"]
      },
      {
        "name": "Manager (Orchestrator)",
        "inputs": ["User Prompt"],
        "outputs": ["Decomposed Tasks", "Plan"]
      },
      {
        "name": "Reviewer Expert",
        "inputs": ["Primary Expert Code", "Thoughts", "Actions"],
        "outputs": ["REVIEW_PASSED", "REVIEW_FAILED"]
      },
      {
        "name": "Security Auditor Expert",
        "inputs": ["SAST/DAST output"],
        "outputs": ["Security Review Summary", "Vulnerability Fixes"]
      },
      {
        "name": "Creative Director Expert",
        "inputs": ["User context"],
        "outputs": ["Creative Brief JSON"]
      },
      {
        "name": "Design System Architect",
        "inputs": ["Creative Brief JSON"],
        "outputs": ["Design System Code", "Tailwind Config"]
      }
    ]
  },
  "dependencyGraph": [
    { "layer": "Layer 5: Audit Layer", "dependsOn": ["Layer 2: Application Layer"] },
    { "layer": "Layer 4: Execution Layer", "dependsOn": ["Layer 2: Application Layer"] },
    { "layer": "Layer 3: Data Layer", "dependsOn": ["Layer 2: Application Layer"] },
    { "layer": "Layer 2: Application Layer", "dependsOn": ["Layer 1: Network Layer"] }
  ]
}
